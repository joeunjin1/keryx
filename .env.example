# ====================================================
# KERYX environment variables
# Copy to .env.local and fill in real values
# ====================================================

# Supabase (from https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anthropic Claude API (for translation, recommendations)
ANTHROPIC_API_KEY=sk-ant-...

# Exchange rate API (https://www.exchangerate-api.com/)
EXCHANGERATE_API_KEY=your-key-here

# Toss Payments (Store checkout; never expose TOSS_SECRET_KEY to the browser or Git)
# Use test keys locally and Vercel Preview. Set live keys only in Vercel Production after merchant review.
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_your_widget_client_key
TOSS_SECRET_KEY=test_sk_your_widget_secret_key

# Scheduled cleanup endpoint authorization (use a strong unique random value)
CRON_SECRET=replace-with-a-unique-random-secret

# App
NEXT_PUBLIC_APP_NAME=KERYX
NEXT_PUBLIC_OPERATOR_NAME=YIWU SENKANG DAILY NECESSITIES CO., LTD
NEXT_PUBLIC_OPERATOR_NAME_ZH=森康
NEXT_PUBLIC_DEFAULT_LOCALE=ko
NEXT_PUBLIC_BASE_CURRENCY=CNY
