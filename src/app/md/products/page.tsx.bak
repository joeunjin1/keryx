'use client';
import { useEffect, useState } from 'react';
import { useRouter } from 'next/navigation';
import Link from 'next/link';
import { createClient } from '@/lib/supabase/client';
import LangText from '@/components/layout/LangText';

const brandColor = '#6366f1'; // MD 포털 색상

export default function MdProductsQueuePage() {
  // 페이지 제목 설정
  useEffect(() => {
    document.title = '상품 데이터 관리 | KERYX';
  }, []);

  const router = useRouter();
  const supabase = createClient() as any;
  const [products, setProducts] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [userName, setUserName] = useState('MD');
  const [actionLoading, setActionLoading] = useState<string | null>(null);

  useEffect(() => {
    (async () => {
      const { data: { user } } = await supabase.auth.getUser();
      if (!user) { router.push('/login?role=internal'); return; }

      const { data: profile } = await supabase.from('user_profiles').select('kind, display_name').eq('id', user.id).single();
      if (!profile || !['md', 'admin'].includes(profile.kind as string)) { router.push('/admin'); return; }

      const { data: me } = await supabase.from('internal_users').select('id, name_ko').eq('user_id', user.id).single();
      if (me?.name_ko) setUserName(me.name_ko);

      // ✅ 공장 포털과 동일한 'products' 테이블 사용 (연동 수정)
      const { data } = await supabase
        .from('products')
        .select(`id, product_code, name_ko, name_zh, moq, price_cny, supply_price_cny, approval_status, created_at, image_url, is_active, stock_qty,
           factory:factories(id, company_name, company_name_ko)`)
        .in('approval_status', ['pending_review', 'under_review'])
        .order('created_at', { ascending: true })
        .limit(50);
      setProducts(data ?? []);
      setLoading(false);
    })();
  }, []);

  const handleAction = async (productId: string, action: 'approve' | 'reject') => {
    setActionLoading(productId);
    // ✅ 공장 포털과 동일한 'products' 테이블 사용
    await supabase.from('products').update({ approval_status: action === 'approve' ? 'approved' : 'rejected' }).eq('id', productId);
    setProducts(prev => prev.filter(p => p.id !== productId));
    setActionLoading(null);
  };

  if (loading) return (
    <div className="text-center px-6 py-20 text-[var(--text-tertiary)]">
      <div className="text-[32px] mb-3">⏳</div>
      <LangText ko="로딩 중..." zh="加载中..." />
    </div>
  );

  return (
    <div>
      <div className="mb-5">
        <h1 className="text-xl font-bold text-[var(--text-primary)] mb-0.5">
          <LangText ko="공장 제품 검토" zh="工厂产品审核" />
        </h1>
        <p className="text-[13px] text-[var(--text-tertiary)]">
          <LangText ko={`검토 대기 ${products.length}건`} zh={`待审核 ${products.length} 件`} />
        </p>
      </div>

      {products.length === 0 ? (
        <div className="text-center px-6 py-12 bg-[var(--bg-base)] border border-[var(--border-light)] rounded-[var(--radius-lg)]">
          <div className="text-[40px] mb-3">✅</div>
          <div className="text-sm text-[var(--text-secondary)]">
            <LangText ko="검토할 제품이 없습니다" zh="没有需要审核的产品" />
          </div>
        </div>
      ) : (
        <div className="flex flex-col gap-3">
          {products.map((p: any) => (
            <div key={p.id} className="bg-[var(--bg-base)] p-4 border border-[var(--border-light)] shadow-[var(--shadow-xs)] rounded-[var(--radius-lg)]">
              <div className="flex items-start justify-between mb-2.5">
                <div className="flex-1">
                  <div className="text-xs text-[var(--text-tertiary)]" style={{ marginBottom: 3 }}>{p.product_code}</div>
                  <div className="text-[15px] font-bold text-[var(--text-primary)]">{p.name_ko ?? p.name_zh}</div>
                  <div className="text-xs text-[var(--text-secondary)] mt-0.5">
                    {p.factory?.company_name_ko ?? p.factory?.company_name}
                  </div>
                </div>
                <div className="text-right shrink-0">
                  <div className="text-base font-bold" style={{ color: brandColor }}>¥{p.price_cny ?? p.supply_price_cny}</div>
                  <div className="text-[11px] text-[var(--text-tertiary)]">MOQ {p.moq}</div>
                </div>
              </div>
              {/* 재고 및 활성 상태 표시 */}
              <div className="flex gap-2 mb-2.5 text-[11px]">
                <span className={`px-2 py-0.5 rounded-full font-semibold ${p.is_active ? 'bg-emerald-50 text-emerald-700' : 'bg-stone-100 text-stone-500'}`}>
                  <LangText ko={p.is_active ? '활성' : '비활성'} zh={p.is_active ? '活跃' : '停用'} />
                </span>
                {p.stock_qty != null && (
                  <span className="px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 font-semibold">
                    <LangText ko={`재고 ${p.stock_qty}`} zh={`库存 ${p.stock_qty}`} />
                  </span>
                )}
              </div>
              <div className="flex gap-2">
                <button
                  onClick={() => handleAction(p.id, 'approve')}
                  disabled={actionLoading === p.id}
                  className="flex-1 bg-emerald-500 text-white border-none text-[13px] font-semibold cursor-pointer p-[10px] rounded-[var(--radius-md)]"
                >
                  ✓ <LangText ko="승인" zh="通过" />
                </button>
                <button
                  onClick={() => handleAction(p.id, 'reject')}
                  disabled={actionLoading === p.id}
                  className="flex-1 border-none text-[13px] font-semibold cursor-pointer p-[10px] bg-[#fee2e2] text-[#dc2626] rounded-[var(--radius-md)]"
                >
                  ✗ <LangText ko="반려" zh="拒绝" />
                </button>
                <Link href={`/md/factory/${p.factory?.id ?? ''}`} className="bg-[var(--bg-subtle)] text-[var(--text-secondary)] border-none text-[13px] no-underline inline-flex items-center py-[10px] px-[14px] rounded-[var(--radius-md)]">
                  🏭
                </Link>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  );
}
