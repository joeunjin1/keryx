export default function LandingPage() {
  const [lang, setLang] = useState<'ko' | 'zh'>('ko');
  const [isLoggedIn, setIsLoggedIn] = useState(false);
  const [userRole, setUserRole] = useState<string | null>(null);

  useEffect(() => {
    try {
      const supabase = createClientComponentClient();
      supabase.auth.getSession().then(({ data: { session } }) => {
        if (session?.user) {
          setIsLoggedIn(true);
          supabase
            .from('user_profiles')
            .select('kind')
            .eq('id', session.user.id)
            .single()
            .then(({ data }) => { if (data) setUserRole(data.kind); });
        }
      });
    } catch { /* ignore */ }
  }, []);

  const t = T[lang];
  const services = SERVICES[lang];
  const why = WHY[lang];
  const process = PROCESS[lang];

  const getDashboardHref = () => {
    if (userRole === 'admin' || userRole === 'md') return '/admin';
    if (userRole === 'factory') return '/factory';
    return '/seller';
  };

  return (
    <div className="min-h-screen bg-white">

      {/* ══════════════════════════════════════
          네비게이션
      ══════════════════════════════════════ */}
      <nav className="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-100 shadow-sm">
        <div className="max-w-6xl mx-auto px-4 sm:px-6">
          <div className="flex items-center justify-between h-16">
            <Link href="/" className="flex items-center">
              <Image
                src="/logos/logo-horizontal.png"
                alt="KERYX"
                width={120}
                height={32}
                style={{ objectFit: 'contain' }}
                priority
                onError={(e) => {
                  const el = e.currentTarget as HTMLImageElement;
                  el.style.display = 'none';
                  const parent = el.parentElement;
                  if (parent) {
                    parent.innerHTML = '<span style="font-size:1.5rem;font-weight:900;background:linear-gradient(135deg,#667eea,#764ba2);-webkit-background-clip:text;-webkit-text-fill-color:transparent">KERYX</span>';
                  }
                }}
              />
            </Link>

            <div className="flex items-center gap-2">
              <button
                onClick={() => setLang(lang === 'ko' ? 'zh' : 'ko')}
                className="hidden sm:flex items-center gap-1 px-3 py-1.5 text-sm text-gray-500 hover:text-gray-800 border border-gray-200 rounded-lg transition-colors"
              >
                🌐 {t.langBtn}
              </button>
              {isLoggedIn ? (
                <Link
                  href={getDashboardHref()}
                  className="px-4 py-2 text-sm font-bold text-white rounded-lg shadow-sm transition-all hover:shadow-md"
                  style={{ background: 'linear-gradient(135deg,#667eea,#764ba2)' }}
                >
                  {t.dashboard}
                </Link>
              ) : (
                <>
                  <Link href="/login" className="px-3 py-2 text-sm text-gray-600 hover:text-gray-900 font-medium">
                    {t.nav_login}
                  </Link>
                  <Link
                    href="/apply/market-research"
                    className="px-4 py-2 text-sm font-bold text-white rounded-lg shadow-sm transition-all hover:shadow-md"
                    style={{ background: 'linear-gradient(135deg,#667eea,#764ba2)' }}
                  >
                    {lang === 'ko' ? '무료 신청' : '免费申请'}
                  </Link>
                </>
              )}
            </div>
          </div>
        </div>
      </nav>

      {/* ══════════════════════════════════════
          히어로 섹션
      ══════════════════════════════════════ */}
      <section
        className="relative overflow-hidden pt-16"
        style={{ background: 'linear-gradient(135deg,#0f0c29 0%,#302b63 50%,#24243e 100%)' }}
      >
        {/* 배경 글로우 */}
        <div className="absolute inset-0 pointer-events-none overflow-hidden">
          <div className="absolute top-20 right-10 w-80 h-80 rounded-full opacity-10"
            style={{ background: 'radial-gradient(circle,#667eea,transparent)' }} />
          <div className="absolute bottom-0 left-0 w-96 h-96 rounded-full opacity-10"
            style={{ background: 'radial-gradient(circle,#764ba2,transparent)' }} />
        </div>

        <div className="relative max-w-6xl mx-auto px-4 sm:px-6 py-24 sm:py-36">
          <div className="max-w-3xl">
            {/* 배지 */}
            <div
              className="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold mb-8"
              style={{ background: 'rgba(102,126,234,0.2)', color: '#a5b4fc', border: '1px solid rgba(102,126,234,0.3)' }}
            >
              ⭐ {t.badge}
            </div>

            {/* 메인 타이틀 */}
            <h1 className="text-4xl sm:text-5xl lg:text-6xl font-black text-white leading-tight mb-6">
              {t.hero_title_1}
              <br />
              <span style={{ background: 'linear-gradient(135deg,#667eea,#a78bfa)', WebkitBackgroundClip: 'text', WebkitTextFillColor: 'transparent' }}>
                {t.hero_title_2}
              </span>
            </h1>

            {/* 부제목 */}
            <p className="text-xl sm:text-2xl text-blue-100 font-semibold mb-5 leading-relaxed">
              {t.hero_sub}
            </p>

            {/* 서비스 목록 */}
            <p className="text-sm sm:text-base text-blue-200/80 mb-4 leading-relaxed">
              {t.hero_desc}
            </p>

            {/* 약속 문구 */}
            <p
              className="text-base sm:text-lg text-white/90 font-bold mb-10 pl-4 leading-relaxed"
              style={{ borderLeft: '4px solid #667eea' }}
            >
              {t.hero_promise}
            </p>

            {/* CTA 버튼 3개 */}
            <div className="flex flex-col sm:flex-row gap-3">
              <Link
                href="/apply/market-research"
                className="flex items-center justify-center gap-2 px-6 py-4 rounded-xl font-bold text-white text-base transition-all hover:scale-105 shadow-lg"
                style={{ background: 'linear-gradient(135deg,#667eea,#764ba2)' }}
              >
                🔍 {t.cta1}
              </Link>
              <Link
                href="/apply/factory-matching"
                className="flex items-center justify-center gap-2 px-6 py-4 rounded-xl font-bold text-white text-base transition-all hover:scale-105 shadow-lg"
                style={{ background: 'linear-gradient(135deg,#f093fb,#f5576c)' }}
              >
                🏭 {t.cta2}
              </Link>
              <Link
                href="/apply/sample-development"
                className="flex items-center justify-center gap-2 px-6 py-4 rounded-xl font-bold text-white text-base transition-all hover:scale-105 shadow-lg"
                style={{ background: 'linear-gradient(135deg,#4facfe,#00f2fe)' }}
              >
                📦 {t.cta3}
              </Link>
            </div>
          </div>
        </div>

        {/* 웨이브 */}
        <div className="relative h-16">
          <svg viewBox="0 0 1440 64" fill="none" xmlns="http://www.w3.org/2000/svg" className="absolute bottom-0 w-full">
            <path d="M0 64L1440 64L1440 0C1200 40 960 56 720 56C480 56 240 40 0 0L0 64Z" fill="white" />
          </svg>
        </div>
      </section>

      {/* ══════════════════════════════════════
          서비스 소개
      ══════════════════════════════════════ */}
      <section className="py-20 bg-white">
        <div className="max-w-6xl mx-auto px-4 sm:px-6">
          <div className="text-center mb-14">
            <h2 className="text-3xl sm:text-4xl font-black text-gray-900 mb-3">{t.services_title}</h2>
            <p className="text-lg text-gray-500">{t.services_sub}</p>
          </div>
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
            {services.map((s, i) => (
              <div
                key={i}
                className="p-6 rounded-2xl border border-gray-100 hover:border-purple-200 hover:shadow-lg transition-all duration-300"
                style={{ background: 'linear-gradient(135deg,#fafafa,#f5f3ff)' }}
              >
                <div className="text-4xl mb-4">{s.icon}</div>
                <h3 className="text-lg font-bold text-gray-900 mb-2">{s.title}</h3>
                <p className="text-sm text-gray-500 leading-relaxed">{s.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* ══════════════════════════════════════
          선택 이유
      ══════════════════════════════════════ */}
      <section className="py-20 bg-gray-50">
        <div className="max-w-6xl mx-auto px-4 sm:px-6">
          <div className="text-center mb-14">
            <h2 className="text-3xl sm:text-4xl font-black text-gray-900 mb-3">{t.why_title}</h2>
            <p className="text-lg text-gray-500">{t.why_sub}</p>
          </div>
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {why.map((w, i) => (
              <div key={i} className="text-center p-8 bg-white rounded-2xl shadow-sm hover:shadow-md transition-shadow">
                <div className="text-5xl mb-4">{w.icon}</div>
                <h3 className="text-lg font-bold text-gray-900 mb-3">{w.title}</h3>
                <p className="text-sm text-gray-500 leading-relaxed">{w.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* ══════════════════════════════════════
          프로세스
      ══════════════════════════════════════ */}
      <section className="py-20 bg-white">
        <div className="max-w-4xl mx-auto px-4 sm:px-6">
          <div className="text-center mb-14">
            <h2 className="text-3xl sm:text-4xl font-black text-gray-900 mb-3">{t.process_title}</h2>
            <p className="text-lg text-gray-500">{t.process_sub}</p>
          </div>
          <div className="flex flex-col sm:flex-row gap-8 sm:gap-4">
            {process.map((p, i) => (
              <div key={i} className="flex-1 text-center px-4">
                <div
                  className="w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 text-white font-black text-2xl shadow-lg"
                  style={{ background: 'linear-gradient(135deg,#667eea,#764ba2)' }}
                >
                  {p.step}
                </div>
                <h3 className="text-lg font-bold text-gray-900 mb-2">{p.title}</h3>
                <p className="text-sm text-gray-500 leading-relaxed">{p.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* ══════════════════════════════════════
          하단 CTA
      ══════════════════════════════════════ */}
      <section
        className="py-20"
        style={{ background: 'linear-gradient(135deg,#667eea 0%,#764ba2 100%)' }}
      >
        <div className="max-w-4xl mx-auto px-4 sm:px-6 text-center">
          <h2 className="text-3xl sm:text-4xl font-black text-white mb-4">{t.cta_bottom_title}</h2>
          <p className="text-lg text-white/80 mb-10">{t.cta_bottom_sub}</p>
          <div className="flex flex-col sm:flex-row gap-4 justify-center">
            <Link
              href="/apply/market-research"
              className="flex items-center justify-center gap-2 px-8 py-4 rounded-xl font-bold text-purple-700 bg-white text-base transition-all hover:scale-105 shadow-lg"
            >
              🔍 {t.cta1}
            </Link>
            <Link
              href="/apply/factory-matching"
              className="flex items-center justify-center gap-2 px-8 py-4 rounded-xl font-bold text-purple-700 bg-white text-base transition-all hover:scale-105 shadow-lg"
            >
              🏭 {t.cta2}
            </Link>
            <Link
              href="/apply/sample-development"
              className="flex items-center justify-center gap-2 px-8 py-4 rounded-xl font-bold text-purple-700 bg-white text-base transition-all hover:scale-105 shadow-lg"
            >
              📦 {t.cta3}
            </Link>
          </div>
        </div>
      </section>

      {/* ══════════════════════════════════════
          푸터
      ══════════════════════════════════════ */}
      <footer className="bg-gray-900 text-gray-400 py-12">
        <div className="max-w-6xl mx-auto px-4 sm:px-6">
          <div className="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-8">
            <div>
              <div className="mb-3">
                <Image
                  src="/logos/logo-horizontal.png"
                  alt="KERYX"
                  width={100}
                  height={28}
                  style={{ objectFit: 'contain', filter: 'brightness(0) invert(0.5)' }}
                  onError={(e) => {
                    const el = e.currentTarget as HTMLImageElement;
                    el.style.display = 'none';
                  }}
                />
              </div>
              <p className="text-sm text-gray-500">{t.footer_slogan}</p>
            </div>
            <div className="text-xs text-gray-600 space-y-1 sm:text-right">
              <p>{t.footer_biz}</p>
              <p>{t.footer_addr}</p>
              <p className="mt-2 text-gray-700">{t.footer_copy}</p>
            </div>
          </div>
          <div className="mt-8 pt-6 border-t border-gray-800 flex justify-center">
            <Link href="/login?role=admin" className="text-xs text-gray-800 hover:text-gray-600 transition-colors">
              {t.admin_link}
            </Link>
          </div>
        </div>
      </footer>
    </div>
  );
}
