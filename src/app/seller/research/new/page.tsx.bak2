'use client';
import Image from 'next/image';
import { useEffect, useState, useRef } from 'react';
import { useRouter } from 'next/navigation';
import Link from 'next/link';
import {
  ArrowLeft, Plus, Trash2, ChevronDown, ChevronUp,
  CheckCircle2, Clock, Zap, Package, Search, FileText,
  AlertCircle, ImagePlus, Link2, X, Info
} from 'lucide-react';
import { createClient } from '@/lib/supabase/client';
import { cn } from '@/lib/utils';
import LangText from '@/components/layout/LangText';

const CATEGORIES = [
  { value: 'toys_goods', label: '완구/굿즈', zh: '玩具/周边' },
  { value: 'bags_accessories', label: '가방/잡화', zh: '包包/杂货' },
  { value: 'fashion_apparel', label: '의류/패션', zh: '服装/时尚' },
  { value: 'homeware', label: '생활용품/인테리어', zh: '生活用品/家居' },
  { value: 'stationery', label: '문구/팬시', zh: '文具/精品' },
  { value: 'beauty_health', label: '뷰티/건강', zh: '美妆/健康' },
  { value: 'electronics', label: '전자/IT', zh: '电子/IT' },
  { value: 'food_beverage', label: '식품/음료', zh: '食品/饮料' },
  { value: 'sports_outdoor', label: '스포츠/아웃도어', zh: '运动/户外' },
  { value: 'other', label: '기타', zh: '其他' },
];

const SHIPPING_METHODS = [
  { value: 'air', label: '빠른 항공', zh: '空运' },
  { value: 'sea_fcl', label: '해상 FCL', zh: '整柜' },
  { value: 'sea_lcl', label: '해상 LCL', zh: '拼柜' },
  { value: 'undecided', label: '미정', zh: '未定' },
];

const DELIVERY_REGIONS = ['서울', '부산', '인천', '대구', '광주', '대전', '직접 입력'];
const QTY_UNITS = ['개', '세트', '박스', 'kg', 'm', '롤'];

interface ResearchItem {
  description: string;
  reference_image_urls: string[];
  desired_unit_price_hint: string;
  desired_qty_hint: string;
  desired_timing: string;
  wants_sample: boolean;
  category: string;
  category_detail: string;
  product_name_hint: string;
  material_spec: string;
  certification_req: string;
  delivery_region: string;
  delivery_region_custom: string;
  shipping_method: string;
  unit_price_min: string;
  unit_price_max: string;
  qty_unit: string;
  sample_qty: number;
  additional_notes: string;
}

const EMPTY_ITEM: ResearchItem = {
  description: '',
  reference_image_urls: [],
  desired_unit_price_hint: '',
  desired_qty_hint: '',
  desired_timing: '',
  wants_sample: false,
  category: '',
  category_detail: '',
  product_name_hint: '',
  material_spec: '',
  certification_req: '',
  delivery_region: '',
  delivery_region_custom: '',
  shipping_method: 'undecided',
  unit_price_min: '',
  unit_price_max: '',
  qty_unit: '개',
  sample_qty: 1,
  additional_notes: '',
};

function ProgressBar({ step }: { step: number }) {
  const steps = [
    { label: '상품 정보 입력', zh: '商品信息' },
    { label: '요청 옵션 설정', zh: '请求设置' },
    { label: '제출 완료', zh: '提交完成' },
  ];
  return (
    <div className="flex items-center justify-between mb-6">
      {steps.map((s, i) => (
        <div key={i} className="flex items-center flex-1">
          <div className="flex flex-col items-center">
            <div className={cn(
              'w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold border-2 transition-all',
              i + 1 < step ? 'bg-emerald-500 border-emerald-500 text-white' :
              i + 1 === step ? 'bg-brand-600 border-brand-600 text-white' :
              'bg-white border-stone-300 text-stone-400'
            )}>
              {i + 1 < step ? <CheckCircle2 className="w-4 h-4" /> : i + 1}
            </div>
            <span className={cn(
              'text-[10px] mt-1 font-medium whitespace-nowrap',
              i + 1 === step ? 'text-brand-600' : 'text-stone-400'
            )}>
              <LangText ko={s.label} zh={s.zh} />
            </span>
          </div>
          {i < steps.length - 1 && (
            <div className={cn(
              'flex-1 h-0.5 mx-2 mb-4 transition-all',
              i + 1 < step ? 'bg-emerald-500' : 'bg-stone-200'
            )} />
          )}
        </div>
      ))}
    </div>
  );
}

function ImageSlots({ urls, onAdd, onRemove }: { urls: string[]; onAdd: () => void; onRemove: (i: number) => void }) {
  return (
    <div className="space-y-2">
      <div className="grid grid-cols-5 gap-2">
        {Array(5).fill(null).map((_, i) => (
          <div key={i} className="relative aspect-square">
            {urls[i] ? (
              <div className="relative w-full h-full rounded-lg overflow-hidden border border-stone-200 group">
                <Image src={urls[i]} alt={`참고사진 ${i + 1}`} fill className="object-cover" />
                <button onClick={() => onRemove(i)} className="absolute top-0.5 right-0.5 bg-black/60 rounded-full p-0.5 opacity-0 group-hover:opacity-100 transition-opacity">
                  <X className="w-2.5 h-2.5 text-white" />
                </button>
                <div className="absolute bottom-0 left-0 right-0 bg-black/40 text-white text-[9px] text-center py-0.5">사진 {i + 1}</div>
              </div>
            ) : (
              <button onClick={onAdd} className={cn('w-full h-full rounded-lg border-2 border-dashed flex flex-col items-center justify-center transition-colors', i === 0 ? 'border-brand-300 bg-brand-50 hover:bg-brand-100' : 'border-stone-200 bg-stone-50 hover:border-stone-300')}>
                <ImagePlus className={cn('w-4 h-4', i === 0 ? 'text-brand-400' : 'text-stone-300')} />
                <span className={cn('text-[9px] mt-0.5', i === 0 ? 'text-brand-400' : 'text-stone-300')}>{i === 0 ? '필수' : `사진${i + 1}`}</span>
              </button>
            )}
          </div>
        ))}
      </div>
      <p className="text-[10px] text-stone-400">JPG, PNG, WEBP · 최대 10MB · 최대 5장 · 클릭하여 업로드</p>
    </div>
  );
}

export default function NewResearchPage() {
  const router = useRouter();
  const supabase = createClient();
  const [seller, setSeller] = useState<any>(null);
  const [items, setItems] = useState<ResearchItem[]>([{ ...EMPTY_ITEM }]);
  const [isUrgent, setIsUrgent] = useState(false);
  const [step, setStep] = useState(1);
  const [submitting, setSubmitting] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [infoOpen, setInfoOpen] = useState(false);
  const [urlInput, setUrlInput] = useState('');
  const [activeItemIdx, setActiveItemIdx] = useState(0);
  const fileRef = useRef<HTMLInputElement>(null);
  const [uploadingFor, setUploadingFor] = useState<number | null>(null);

  useEffect(() => {
    (async () => {
      const { data: { user } } = await supabase.auth.getUser();
      if (!user) { router.push('/login?role=seller'); return; }
      const { data: s } = await supabase.from('sellers').select('id, business_name, current_grade, current_membership, assigned_md_id').eq('user_id', user.id).single();
      setSeller(s);
    })();
  }, [router, supabase]);

  function patchItem(idx: number, patch: Partial<ResearchItem>) {
    setItems(cur => cur.map((it, i) => i === idx ? { ...it, ...patch } : it));
  }
  function addItem() {
    if (items.length < 10) {
      setItems(cur => [...cur, { ...EMPTY_ITEM }]);
      setActiveItemIdx(items.length);
    }
  }
  function removeItem(idx: number) {
    if (items.length > 1) {
      setItems(cur => cur.filter((_, i) => i !== idx));
      setActiveItemIdx(Math.max(0, idx - 1));
    }
  }

  async function handleFiles(e: React.ChangeEvent<HTMLInputElement>) {
    if (uploadingFor === null) return;
    const files = Array.from(e.target.files ?? []);
    if (!files.length) return;
    const idx = uploadingFor;
    const newUrls: string[] = [];
    for (const file of files) {
      const path = `${seller.id}/${Date.now()}-${file.name}`;
      const { data: uploaded, error } = await supabase.storage.from('research-references').upload(path, file);
      if (error || !uploaded) continue;
      const { data: signed } = await supabase.storage.from('research-references').createSignedUrl(uploaded.path, 60 * 60 * 24 * 90);
      if (signed) newUrls.push(signed.signedUrl);
    }
    patchItem(idx, { reference_image_urls: [...items[idx].reference_image_urls, ...newUrls].slice(0, 5) });
    setUploadingFor(null);
    if (fileRef.current) fileRef.current.value = '';
  }

  function pickImagesFor(idx: number) { setUploadingFor(idx); setTimeout(() => fileRef.current?.click(), 0); }
  function removeImage(itemIdx: number, imgIdx: number) {
    patchItem(itemIdx, { reference_image_urls: items[itemIdx].reference_image_urls.filter((_, i) => i !== imgIdx) });
  }

  function validateStep1() {
    for (const it of items) {
      if (!it.category) { setError('카테고리를 선택해주세요.'); return false; }
      if (!it.product_name_hint.trim()) { setError('상품명/키워드를 입력해주세요.'); return false; }
      if (it.description.trim().length < 10) { setError('상품 설명을 10자 이상 입력해주세요.'); return false; }
    }
    setError(null); return true;
  }

  function goStep2() { if (validateStep1()) setStep(2); }

  async function submit() {
    setError(null); setSubmitting(true);
    const res = await fetch('/api/research', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        items: items.map(it => ({
          description: it.description.trim(),
          reference_image_urls: it.reference_image_urls,
          desired_unit_price_hint: it.unit_price_min && it.unit_price_max ? `¥${it.unit_price_min}~${it.unit_price_max}` : it.desired_unit_price_hint || undefined,
          desired_qty_hint: it.desired_qty_hint ? `${it.desired_qty_hint}${it.qty_unit}` : undefined,
          desired_timing: it.desired_timing || undefined,
          wants_sample: it.wants_sample,
          additional_notes: [
            it.category ? `카테고리: ${CATEGORIES.find(c => c.value === it.category)?.label}` : '',
            it.category_detail ? `세부: ${it.category_detail}` : '',
            it.product_name_hint ? `키워드: ${it.product_name_hint}` : '',
            it.material_spec ? `소재: ${it.material_spec}` : '',
            it.certification_req ? `인증: ${it.certification_req}` : '',
            it.delivery_region ? `납품지: ${it.delivery_region === '직접 입력' ? it.delivery_region_custom : it.delivery_region}` : '',
            it.shipping_method !== 'undecided' ? `배송: ${SHIPPING_METHODS.find(s => s.value === it.shipping_method)?.label}` : '',
            it.additional_notes ? `메모: ${it.additional_notes}` : '',
          ].filter(Boolean).join(' | ') || undefined,
        })),
        is_urgent: isUrgent,
      }),
    });
    setSubmitting(false);
    if (!res.ok) { const j = await res.json().catch(() => ({})); setError(j.error ?? '제출에 실패했습니다.'); return; }
    const { request } = await res.json();
    setStep(3);
    setTimeout(() => router.push(`/seller/research/${request.id}`), 2000);
  }

  if (!seller) return (
    <div className="min-h-dvh flex items-center justify-center bg-stone-50">
      <div className="text-center">
        <div className="w-8 h-8 border-2 border-brand-600 border-t-transparent rounded-full animate-spin mx-auto mb-3" />
        <p className="text-sm text-stone-500"><LangText ko="불러오는 중…" zh="加载中…" /></p>
      </div>
    </div>
  );

  const isUnlimited = ['unlimited', 'vip_auto'].includes(seller.current_membership ?? '');
  const isVip = seller.current_grade === 'vip';

  /* 제출 완료 화면 */
  if (step === 3) return (
    <div className="min-h-dvh bg-gradient-to-br from-emerald-50 to-brand-50 flex items-center justify-center p-6">
      <div className="bg-white rounded-2xl shadow-lg p-8 max-w-sm w-full text-center">
        <div className="w-16 h-16 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <CheckCircle2 className="w-8 h-8 text-emerald-500" />
        </div>
        <h2 className="text-xl font-bold text-stone-800 mb-2"><LangText ko="요청이 접수되었습니다!" zh="申请已提交！" /></h2>
        <p className="text-sm text-stone-500 mb-6"><LangText ko="MD가 배정되어 조사를 시작합니다." zh="MD将被分配并开始调查。" /></p>
        <div className="bg-stone-50 rounded-xl p-4 text-left space-y-2 mb-6">
          {[
            { icon: CheckCircle2, label: '요청 접수', zh: '请求接收', done: true },
            { icon: CheckCircle2, label: 'MD 배정 (당일)', zh: 'MD分配（当天）', done: false },
            { icon: Search, label: '중국 현지 조사', zh: '中国本地调查', done: false },
            { icon: FileText, label: '보고서 발송 (2~7일)', zh: '报告发送（2-7天）', done: false },
          ].map((s, i) => (
            <div key={i} className="flex items-center gap-2">
              <s.icon className={cn('w-4 h-4', s.done ? 'text-emerald-500' : 'text-stone-300')} />
              <span className={cn('text-xs', s.done ? 'text-emerald-600 font-medium' : 'text-stone-400')}><LangText ko={s.label} zh={s.zh} /></span>
            </div>
          ))}
        </div>
        <p className="text-xs text-stone-400">잠시 후 상세 페이지로 이동합니다…</p>
      </div>
    </div>
  );

  return (
    <main className="min-h-dvh bg-stone-50">
      {/* 헤더 */}
      <header className="bg-white border-b border-stone-200 sticky top-0 z-10">
        <div className="max-w-2xl mx-auto px-4 py-3 flex items-center justify-between">
          <div className="flex items-center gap-3">
            <Link href="/seller" className="text-stone-400 hover:text-stone-700 transition-colors">
              <ArrowLeft className="w-5 h-5" />
            </Link>
            <div>
              <div className="text-base font-bold text-stone-800"><LangText ko="상품 찾아주세요" zh="请帮我找产品" /></div>
              <div className="text-[11px] text-stone-400"><LangText ko="시장조사 요청" zh="市场调研申请" /></div>
            </div>
          </div>
          {isUnlimited && (
            <span className="px-2 py-1 bg-amber-100 text-amber-700 text-[10px] font-bold rounded-full">
              {isVip ? 'VIP' : '무제한'} · 차감 없음
            </span>
          )}
        </div>
      </header>

      <div className="max-w-2xl mx-auto px-4 py-6">
        <ProgressBar step={step} />

        {/* 가치 제안 배너 */}
        <div className="bg-gradient-to-r from-brand-600 to-brand-800 rounded-2xl p-5 mb-5 text-white">
          <div className="grid grid-cols-2 gap-3 mb-4">
            {[
              { icon: Search, label: '중국 현지 MD가 직접 조사', zh: '中国本地MD直接调查' },
              { icon: Clock, label: '2~7일 내 보고서 수령', zh: '2-7天内收到报告' },
              { icon: Package, label: '공급업체 비교 견적 포함', zh: '包含供应商比较报价' },
              { icon: CheckCircle2, label: '샘플 연결까지 원스톱', zh: '一站式样品连接' },
            ].map((v, i) => (
              <div key={i} className="flex items-center gap-2">
                <v.icon className="w-4 h-4 text-brand-200 flex-shrink-0" />
                <span className="text-xs text-brand-100"><LangText ko={v.label} zh={v.zh} /></span>
              </div>
            ))}
          </div>
          <button onClick={() => setInfoOpen(!infoOpen)} className="flex items-center gap-1.5 text-xs text-brand-200 hover:text-white transition-colors">
            <Info className="w-3.5 h-3.5" />
            <LangText ko="이용 안내 보기" zh="查看使用说明" />
            {infoOpen ? <ChevronUp className="w-3 h-3" /> : <ChevronDown className="w-3 h-3" />}
          </button>
          {infoOpen && (
            <div className="mt-3 pt-3 border-t border-brand-500 text-xs text-brand-100 space-y-1">
              <p>• 상품 1개 = 1건 차감 · 응답 2~7일 · 보고서는 운영자 승인 후 발송</p>
              <p>• 샘플 신청 시 제작비 + 국내 배송비 실비 청구</p>
              <p>• 긴급 요청 시 +1건 추가 차감 (2~3일 이내 처리)</p>
              <p>• VIP/무제한 멤버십은 차감 없이 이용 가능</p>
            </div>
          )}
        </div>

        {/* STEP 1: 상품 정보 입력 */}
        {step === 1 && (
          <div className="space-y-4">
            {/* 상품 탭 네비게이션 (다중 상품) */}
            {items.length > 1 && (
              <div className="flex gap-2 overflow-x-auto pb-1">
                {items.map((_, i) => (
                  <button key={i} onClick={() => setActiveItemIdx(i)} className={cn('flex-shrink-0 px-3 py-1.5 rounded-lg text-xs font-medium transition-colors', activeItemIdx === i ? 'bg-brand-600 text-white' : 'bg-white border border-stone-200 text-stone-500 hover:border-brand-300')}>
                    상품 {i + 1}
                  </button>
                ))}
              </div>
            )}

            {items.map((it, idx) => (
              <div key={idx} className={cn('bg-white rounded-2xl shadow-sm border overflow-hidden transition-all', items.length > 1 && idx !== activeItemIdx ? 'hidden' : 'block', activeItemIdx === idx ? 'border-brand-200' : 'border-stone-100')}>
                <div className="flex items-center justify-between px-5 py-3 bg-stone-50 border-b border-stone-100">
                  <div className="flex items-center gap-2">
                    <span className="w-6 h-6 bg-brand-600 text-white text-xs font-bold rounded-full flex items-center justify-center">{idx + 1}</span>
                    <span className="text-sm font-semibold text-stone-700"><LangText ko={`상품 ${idx + 1}`} zh={`商品 ${idx + 1}`} /></span>
                  </div>
                  {items.length > 1 && (
                    <button onClick={() => removeItem(idx)} className="text-stone-300 hover:text-red-500 transition-colors">
                      <Trash2 className="w-4 h-4" />
                    </button>
                  )}
                </div>

                <div className="p-5 space-y-4">
                  {/* 카테고리 */}
                  <div className="grid grid-cols-2 gap-3">
                    <div>
                      <label className="block text-xs font-semibold text-stone-600 mb-1.5"><LangText ko="상품 카테고리 *" zh="商品类别 *" /></label>
                      <select value={it.category} onChange={e => patchItem(idx, { category: e.target.value })} className="w-full h-9 px-3 text-sm border border-stone-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 bg-white">
                        <option value=""><LangText ko="카테고리 선택" zh="选择类别" /></option>
                        {CATEGORIES.map(c => <option key={c.value} value={c.value}>{c.label}</option>)}
                      </select>
                    </div>
                    <div>
                      <label className="block text-xs font-semibold text-stone-600 mb-1.5"><LangText ko="세부 카테고리" zh="细分类别" /></label>
                      <input type="text" value={it.category_detail} onChange={e => patchItem(idx, { category_detail: e.target.value })} placeholder="예: 뽑기용 피규어" className="w-full h-9 px-3 text-sm border border-stone-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600" />
                    </div>
                  </div>

                  {/* 상품명/키워드 */}
                  <div>
                    <label className="block text-xs font-semibold text-stone-600 mb-1.5"><LangText ko="상품명 / 키워드 *" zh="商品名称/关键词 *" /></label>
                    <input type="text" value={it.product_name_hint} onChange={e => patchItem(idx, { product_name_hint: e.target.value })} placeholder="예: 방풍 자켓, 3레이어, 남성용" className="w-full h-9 px-3 text-sm border border-stone-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600" />
                  </div>

                  {/* 상세 설명 */}
                  <div>
                    <div className="flex items-center justify-between mb-1.5">
                      <label className="text-xs font-semibold text-stone-600"><LangText ko="상세 설명 *" zh="详细说明 *" /></label>
                      <span className="text-[10px] text-stone-400">{it.description.length}/500</span>
                    </div>
                    <textarea value={it.description} onChange={e => patchItem(idx, { description: e.target.value.slice(0, 500) })} placeholder="어디서 보셨는지, 용도, 참고 브랜드, 원하는 스타일 등 자세히 적어주세요 (최소 10자)" rows={3} className="w-full text-sm border border-stone-200 rounded-lg p-3 resize-none focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600" />
                  </div>

                  {/* 소재/스펙 & 인증/라벨 */}
                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                      <label className="block text-xs font-semibold text-stone-600 mb-1.5"><LangText ko="소재 · 스펙 요건" zh="材质/规格要求" /></label>
                      <input type="text" value={it.material_spec} onChange={e => patchItem(idx, { material_spec: e.target.value })} placeholder="예: 100% 폴리에스터, 방수 코팅" className="w-full h-9 px-3 text-sm border border-stone-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600" />
                    </div>
                    <div>
                      <label className="block text-xs font-semibold text-stone-600 mb-1.5"><LangText ko="인증 · 라벨 요건" zh="认证/标签要求" /></label>
                      <input type="text" value={it.certification_req} onChange={e => patchItem(idx, { certification_req: e.target.value })} placeholder="예: KC인증, 한국어 라벨, 바코드" className="w-full h-9 px-3 text-sm border border-stone-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600" />
                    </div>
                  </div>

                  {/* 희망 단가 */}
                  <div>
                    <label className="block text-xs font-semibold text-stone-600 mb-1.5"><LangText ko="희망 단가 (¥ 위안, FOB 기준)" zh="期望单价（¥人民币，FOB基准）" /></label>
                    <div className="flex items-center gap-2">
                      <div className="relative flex-1">
                        <span className="absolute left-3 top-1/2 -translate-y-1/2 text-stone-400 text-sm">¥</span>
                        <input type="number" value={it.unit_price_min} onChange={e => patchItem(idx, { unit_price_min: e.target.value })} placeholder="최소" className="w-full h-9 pl-7 pr-3 text-sm border border-stone-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600" />
                      </div>
                      <span className="text-stone-400 text-sm">~</span>
                      <div className="relative flex-1">
                        <span className="absolute left-3 top-1/2 -translate-y-1/2 text-stone-400 text-sm">¥</span>
                        <input type="number" value={it.unit_price_max} onChange={e => patchItem(idx, { unit_price_max: e.target.value })} placeholder="최대" className="w-full h-9 pl-7 pr-3 text-sm border border-stone-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600" />
                      </div>
                    </div>
                    <p className="text-[10px] text-stone-400 mt-1">💡 FOB 기준 위안화로 입력하시면 정확한 조사가 가능합니다</p>
                  </div>

                  {/* 예상 수량 & 필요 시기 */}
                  <div className="grid grid-cols-2 gap-3">
                    <div>
                      <label className="block text-xs font-semibold text-stone-600 mb-1.5"><LangText ko="예상 주문 수량" zh="预计订购数量" /></label>
                      <div className="flex gap-1.5">
                        <input type="text" value={it.desired_qty_hint} onChange={e => patchItem(idx, { desired_qty_hint: e.target.value })} placeholder="1,000" className="flex-1 h-9 px-3 text-sm border border-stone-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600" />
                        <select value={it.qty_unit} onChange={e => patchItem(idx, { qty_unit: e.target.value })} className="w-16 h-9 px-1 text-xs border border-stone-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 bg-white">
                          {QTY_UNITS.map(u => <option key={u} value={u}>{u}</option>)}
                        </select>
                      </div>
                    </div>
                    <div>
                      <label className="block text-xs font-semibold text-stone-600 mb-1.5"><LangText ko="필요 시기" zh="需要时间" /></label>
                      <input type="text" value={it.desired_timing} onChange={e => patchItem(idx, { desired_timing: e.target.value })} placeholder="예: 9월 중순" className="w-full h-9 px-3 text-sm border border-stone-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600" />
                    </div>
                  </div>

                  {/* 납품 지역 & 배송 방식 */}
                  <div className="grid grid-cols-2 gap-3">
                    <div>
                      <label className="block text-xs font-semibold text-stone-600 mb-1.5"><LangText ko="납품 희망 지역" zh="期望交货地区" /></label>
                      <select value={it.delivery_region} onChange={e => patchItem(idx, { delivery_region: e.target.value })} className="w-full h-9 px-3 text-sm border border-stone-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 bg-white">
                        <option value=""><LangText ko="지역 선택" zh="选择地区" /></option>
                        {DELIVERY_REGIONS.map(r => <option key={r} value={r}>{r}</option>)}
                      </select>
                      {it.delivery_region === '직접 입력' && (
                        <input type="text" value={it.delivery_region_custom} onChange={e => patchItem(idx, { delivery_region_custom: e.target.value })} placeholder="직접 입력" className="w-full h-9 px-3 text-sm border border-stone-200 rounded-lg mt-1.5 focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600" />
                      )}
                    </div>
                    <div>
                      <label className="block text-xs font-semibold text-stone-600 mb-1.5"><LangText ko="배송 방식" zh="运输方式" /></label>
                      <select value={it.shipping_method} onChange={e => patchItem(idx, { shipping_method: e.target.value })} className="w-full h-9 px-3 text-sm border border-stone-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600 bg-white">
                        {SHIPPING_METHODS.map(s => <option key={s.value} value={s.value}>{s.label}</option>)}
                      </select>
                    </div>
                  </div>

                  {/* 이미지 업로드 */}
                  <div>
                    <label className="block text-xs font-semibold text-stone-600 mb-2">
                      <LangText ko="참고 사진" zh="参考图片" />
                      <span className="text-stone-400 font-normal ml-1">(최소 1장 권장 · 최대 5장)</span>
                    </label>
                    <ImageSlots urls={it.reference_image_urls} onAdd={() => pickImagesFor(idx)} onRemove={(imgIdx) => removeImage(idx, imgIdx)} />
                    <div className="mt-2">
                      <div className="flex items-center gap-1.5 text-[11px] text-stone-400 mb-1">
                        <Link2 className="w-3 h-3" />
                        <LangText ko="또는 이미지 URL 링크로 첨부" zh="或通过图片URL链接附加" />
                      </div>
                      <input type="url" value={urlInput} onChange={e => setUrlInput(e.target.value)} onKeyDown={e => { if (e.key === 'Enter' && urlInput) { patchItem(idx, { reference_image_urls: [...it.reference_image_urls, urlInput].slice(0, 5) }); setUrlInput(''); } }} placeholder="https://... (Enter로 추가)" className="w-full h-8 px-3 text-xs border border-stone-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600" />
                    </div>
                  </div>

                  {/* 샘플 신청 */}
                  <div>
                    <label className="block text-xs font-semibold text-stone-600 mb-2"><LangText ko="샘플 신청" zh="样品申请" /></label>
                    <div className="grid grid-cols-2 gap-2">
                      <button onClick={() => patchItem(idx, { wants_sample: false })} className={cn('py-3 rounded-xl border-2 text-sm font-medium transition-all', !it.wants_sample ? 'border-brand-600 bg-brand-50 text-brand-700' : 'border-stone-200 bg-white text-stone-500 hover:border-stone-300')}>
                        <div className="text-base mb-0.5">📋</div>
                        <LangText ko="필요 없음" zh="不需要" />
                      </button>
                      <button onClick={() => patchItem(idx, { wants_sample: true })} className={cn('py-3 rounded-xl border-2 text-sm font-medium transition-all', it.wants_sample ? 'border-emerald-500 bg-emerald-50 text-emerald-700' : 'border-stone-200 bg-white text-stone-500 hover:border-stone-300')}>
                        <div className="text-base mb-0.5">📦</div>
                        <LangText ko="샘플 받고 싶음" zh="需要样品" />
                      </button>
                    </div>
                    {it.wants_sample && (
                      <div className="mt-2 p-3 bg-emerald-50 rounded-xl border border-emerald-100">
                        <div className="flex items-center gap-2">
                          <label className="text-xs text-emerald-700 font-medium"><LangText ko="희망 샘플 수량" zh="希望样品数量" /></label>
                          <div className="flex items-center gap-1.5 ml-auto">
                            <button onClick={() => patchItem(idx, { sample_qty: Math.max(1, it.sample_qty - 1) })} className="w-6 h-6 rounded-full bg-white border border-emerald-200 text-emerald-600 flex items-center justify-center text-sm hover:bg-emerald-100">−</button>
                            <span className="w-8 text-center text-sm font-bold text-emerald-700">{it.sample_qty}</span>
                            <button onClick={() => patchItem(idx, { sample_qty: Math.min(10, it.sample_qty + 1) })} className="w-6 h-6 rounded-full bg-white border border-emerald-200 text-emerald-600 flex items-center justify-center text-sm hover:bg-emerald-100">+</button>
                            <span className="text-xs text-emerald-600">개</span>
                          </div>
                        </div>
                        <p className="text-[10px] text-emerald-600 mt-1">ℹ 샘플비 + 국내 배송비 실비 청구</p>
                      </div>
                    )}
                  </div>

                  {/* 추가 메모 */}
                  <div>
                    <label className="block text-xs font-semibold text-stone-600 mb-1.5"><LangText ko="추가 메모 (선택)" zh="附加备注（可选）" /></label>
                    <textarea value={it.additional_notes} onChange={e => patchItem(idx, { additional_notes: e.target.value })} placeholder="기타 요청사항, 참고 링크, 특이사항 등" rows={2} className="w-full text-sm border border-stone-200 rounded-lg p-3 resize-none focus:outline-none focus:ring-2 focus:ring-brand-600/20 focus:border-brand-600" />
                  </div>
                </div>
              </div>
            ))}

            {/* 상품 추가 버튼 */}
            {items.length < 10 && (
              <button onClick={addItem} className="w-full py-4 border-2 border-dashed border-stone-200 hover:border-brand-400 rounded-2xl text-stone-400 hover:text-brand-600 text-sm flex items-center justify-center gap-2 transition-colors">
                <Plus className="w-4 h-4" />
                <LangText ko="상품 추가하기" zh="添加商品" />
                <span className="text-xs text-stone-300">({items.length}/10)</span>
              </button>
            )}

            {error && (
              <div className="flex items-center gap-2 text-sm text-red-600 bg-red-50 p-3 rounded-xl border border-red-100">
                <AlertCircle className="w-4 h-4 flex-shrink-0" />{error}
              </div>
            )}

            <button onClick={goStep2} className="w-full py-4 bg-brand-600 hover:bg-brand-800 text-white text-sm font-bold rounded-xl transition-colors shadow-sm">
              <LangText ko="다음 단계 — 요청 옵션 설정 →" zh="下一步 — 设置请求选项 →" />
            </button>
          </div>
        )}

        {/* STEP 2: 요청 옵션 설정 */}
        {step === 2 && (
          <div className="space-y-4">
            {/* 요청 요약 */}
            <div className="bg-white rounded-2xl shadow-sm border border-stone-100 p-5">
              <h3 className="text-sm font-bold text-stone-700 mb-3"><LangText ko="요청 요약" zh="申请摘要" /></h3>
              <div className="space-y-2">
                {items.map((it, i) => (
                  <div key={i} className="flex items-start gap-2 p-2 bg-stone-50 rounded-lg">
                    <span className="w-5 h-5 bg-brand-600 text-white text-[10px] font-bold rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">{i + 1}</span>
                    <div className="flex-1 min-w-0">
                      <p className="text-xs font-medium text-stone-700 truncate">{it.product_name_hint || it.description.slice(0, 30) || '상품 정보'}</p>
                      <p className="text-[10px] text-stone-400">
                        {CATEGORIES.find(c => c.value === it.category)?.label || '카테고리 미선택'}
                        {it.desired_qty_hint && ` · ${it.desired_qty_hint}${it.qty_unit}`}
                        {(it.unit_price_min || it.unit_price_max) && ` · ¥${it.unit_price_min}~${it.unit_price_max}`}
                      </p>
                    </div>
                    <button onClick={() => { setStep(1); setActiveItemIdx(i); }} className="text-[10px] text-brand-600 hover:underline flex-shrink-0">수정</button>
                  </div>
                ))}
              </div>
            </div>

            {/* 우선순위 선택 */}
            <div className="bg-white rounded-2xl shadow-sm border border-stone-100 p-5">
              <h3 className="text-sm font-bold text-stone-700 mb-3"><LangText ko="처리 우선순위" zh="处理优先级" /></h3>
              <div className="grid grid-cols-2 gap-3">
                <button onClick={() => setIsUrgent(false)} className={cn('p-4 rounded-xl border-2 text-left transition-all', !isUrgent ? 'border-brand-600 bg-brand-50' : 'border-stone-200 bg-white hover:border-stone-300')}>
                  <div className="flex items-center gap-2 mb-2">
                    <Clock className={cn('w-5 h-5', !isUrgent ? 'text-brand-600' : 'text-stone-400')} />
                    <span className={cn('text-sm font-bold', !isUrgent ? 'text-brand-700' : 'text-stone-600')}><LangText ko="표준" zh="标准" /></span>
                  </div>
                  <p className={cn('text-xs', !isUrgent ? 'text-brand-600' : 'text-stone-400')}><LangText ko="7일 이내" zh="7天以内" /></p>
                  <p className={cn('text-xs mt-1', !isUrgent ? 'text-brand-500' : 'text-stone-400')}><LangText ko="기본 포함 · 0건 추가 차감" zh="基本包含 · 不额外扣除" /></p>
                  {!isUrgent && <div className="mt-2 flex items-center gap-1 text-[10px] text-brand-600 font-bold"><CheckCircle2 className="w-3 h-3" /> 선택됨</div>}
                </button>
                <button onClick={() => setIsUrgent(true)} className={cn('p-4 rounded-xl border-2 text-left transition-all', isUrgent ? 'border-amber-500 bg-amber-50' : 'border-stone-200 bg-white hover:border-stone-300')}>
                  <div className="flex items-center gap-2 mb-2">
                    <Zap className={cn('w-5 h-5', isUrgent ? 'text-amber-500' : 'text-stone-400')} />
                    <span className={cn('text-sm font-bold', isUrgent ? 'text-amber-700' : 'text-stone-600')}><LangText ko="긴급" zh="紧急" /></span>
                  </div>
                  <p className={cn('text-xs', isUrgent ? 'text-amber-600' : 'text-stone-400')}><LangText ko="2~3일 이내" zh="2-3天以内" /></p>
                  <p className={cn('text-xs mt-1', isUrgent ? 'text-amber-500' : 'text-stone-400')}><LangText ko="우선 MD 배정 · +1건 차감" zh="优先MD分配 · +1扣除" /></p>
                  {isUrgent && <div className="mt-2 flex items-center gap-1 text-[10px] text-amber-600 font-bold"><CheckCircle2 className="w-3 h-3" /> 선택됨</div>}
                </button>
              </div>
            </div>

            {/* 제출 후 프로세스 안내 */}
            <div className="bg-white rounded-2xl shadow-sm border border-stone-100 p-5">
              <h3 className="text-sm font-bold text-stone-700 mb-3"><LangText ko="제출 후 진행 흐름" zh="提交后处理流程" /></h3>
              <div className="flex items-center gap-1">
                {[
                  { label: '요청 접수', zh: '请求接收', icon: CheckCircle2, color: 'text-emerald-500' },
                  { label: 'MD 배정', zh: 'MD分配', icon: CheckCircle2, color: 'text-brand-500' },
                  { label: '현지 조사', zh: '本地调查', icon: Search, color: 'text-amber-500' },
                  { label: '보고서 발송', zh: '报告发送', icon: FileText, color: 'text-purple-500' },
                ].map((s, i, arr) => (
                  <div key={i} className="flex items-center flex-1">
                    <div className="flex flex-col items-center flex-1">
                      <s.icon className={cn('w-5 h-5 mb-1', s.color)} />
                      <span className="text-[9px] text-stone-500 text-center leading-tight"><LangText ko={s.label} zh={s.zh} /></span>
                    </div>
                    {i < arr.length - 1 && <div className="w-4 h-px bg-stone-200 flex-shrink-0" />}
                  </div>
                ))}
              </div>
              <p className="text-[10px] text-stone-400 mt-3 text-center"><LangText ko="당일 접수 → MD 배정 → 2~7일 내 보고서 수령" zh="当天接收 → MD分配 → 2-7天内收到报告" /></p>
            </div>

            {error && (
              <div className="flex items-center gap-2 text-sm text-red-600 bg-red-50 p-3 rounded-xl border border-red-100">
                <AlertCircle className="w-4 h-4 flex-shrink-0" />{error}
              </div>
            )}

            <div className="flex gap-3">
              <button onClick={() => setStep(1)} className="flex-1 py-4 bg-white border border-stone-200 hover:bg-stone-50 text-stone-600 text-sm font-medium rounded-xl transition-colors">
                ← <LangText ko="이전" zh="上一步" />
              </button>
              <button onClick={submit} disabled={submitting} className="flex-[2] py-4 bg-brand-600 hover:bg-brand-800 disabled:opacity-50 text-white text-sm font-bold rounded-xl transition-colors shadow-sm flex items-center justify-center gap-2">
                {submitting ? (
                  <><div className="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin" /><LangText ko="전송 중…" zh="发送中…" /></>
                ) : (
                  <><Search className="w-4 h-4" /><LangText ko="MD에게 시장조사 요청 보내기" zh="向MD发送市场调研请求" /></>
                )}
              </button>
            </div>
          </div>
        )}
      </div>

      <input ref={fileRef} type="file" accept="image/*" multiple onChange={handleFiles} className="hidden" />
    </main>
  );
}
