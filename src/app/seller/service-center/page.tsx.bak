'use client';
import { useState, useEffect } from 'react';
import { useRouter } from 'next/navigation';
import Link from 'next/link';
import { createClient } from '@/lib/supabase/client';
import { useLangContext } from '@/components/layout/LangContext';

const brandColor = '#f97316';

// ── 서비스 신청(service_requests) 상태 ──
const SR_STATUS: Record<string, { ko: string; zh: string; color: string }> = {
  pending:     { ko: '접수 대기', zh: '待接收', color: '#f59e0b' },
  in_progress: { ko: '처리 중',   zh: '处理中', color: '#4f46e5' },
  replied:     { ko: 'MD 답변',   zh: 'MD回复', color: '#10b981' },
  completed:   { ko: '완료',      zh: '已完成', color: '#6b7280' },
  cancelled:   { ko: '취소',      zh: '已取消', color: '#ef4444' },
};

// ── 통합의뢰(unified_requests) 상태 ──
const UR_STATUS: Record<string, { ko: string; zh: string; color: string }> = {
  submitted:    { ko: '접수됨',    zh: '已提交', color: '#3b82f6' },
  reviewing:    { ko: '검토 중',   zh: '审核中', color: '#f59e0b' },
  in_progress:  { ko: '진행 중',   zh: '进行中', color: '#10b981' },
  report_ready: { ko: '보고서 완료', zh: '报告完成', color: '#7c3aed' },
  completed:    { ko: '완료',      zh: '已完成', color: '#6b7280' },
  cancelled:    { ko: '취소됨',    zh: '已取消', color: '#ef4444' },
};

// ── 서비스 타입 ──
const SERVICE_TYPE: Record<string, { ko: string; zh: string; icon: string; color: string }> = {
  'market-research':    { ko: '시장조사',   zh: '市场调研', icon: '🔍', color: '#4f46e5' },
  'factory-matching':   { ko: '공장매칭',   zh: '工厂匹配', icon: '🏭', color: '#0891b2' },
  'sample-development': { ko: '샘플개발',   zh: '样品开发', icon: '📦', color: '#059669' },
  'market_research':    { ko: '시장조사',   zh: '市场调研', icon: '🔍', color: '#4f46e5' },
  'factory_matching':   { ko: '공장매칭',   zh: '工厂匹配', icon: '🏭', color: '#0891b2' },
};

type MainTab = 'service-requests' | 'unified-requests';

export default function SellerServiceCenterPage() {
  const { lang } = useLangContext();
  const t = (ko: string, zh: string) => lang === 'zh' ? zh : ko;
  const router = useRouter();
  const supabase = createClient() as any;

  const [loading, setLoading] = useState(true);
  const [mainTab, setMainTab] = useState<MainTab>('service-requests');

  // 서비스 신청 목록
  const [serviceRequests, setServiceRequests] = useState<any[]>([]);
  const [srFilter, setSrFilter] = useState<string>('all');

  // 통합의뢰 목록
  const [unifiedRequests, setUnifiedRequests] = useState<any[]>([]);

  useEffect(() => {
    (async () => {
      const { data: { user } } = await supabase.auth.getUser();
      if (!user) { router.push('/login?role=seller'); return; }

      const { data: profile } = await supabase
        .from('user_profiles')
        .select('kind')
        .eq('id', user.id)
        .single();
      if (!profile || !['seller', 'admin'].includes(profile.kind)) {
        router.push('/login?role=seller'); return;
      }

      // 서비스 신청 목록 로드
      const { data: srData } = await supabase
        .from('service_requests')
        .select(`
          id, request_no, service_type, status,
          product_name, product_name_zh,
          is_urgent, created_at,
          replies:service_request_replies(id)
        `)
        .eq('user_id', user.id)
        .order('created_at', { ascending: false })
        .limit(50);
      setServiceRequests(srData ?? []);

      // 통합의뢰 목록 로드
      try {
        const res = await fetch('/api/unified-request');
        const data = await res.json();
        setUnifiedRequests(data.data || []);
      } catch {
        setUnifiedRequests([]);
      }

      setLoading(false);
    })();
  }, []);

  const filteredSR = srFilter === 'all'
    ? serviceRequests
    : serviceRequests.filter(r => r.status === srFilter);

  const pendingSRCount = serviceRequests.filter(r => r.status === 'replied').length;
  const pendingURCount = unifiedRequests.filter(r => r.status === 'report_ready').length;

  if (loading) {
    return (
      <div className="flex items-center justify-center min-h-[60vh]">
        <div className="text-center">
          <div className="w-10 h-10 border-4 border-orange-500 border-t-transparent rounded-full animate-spin mx-auto mb-3" />
          <p className="text-gray-500 text-sm">{t('로딩 중...', '加载中...')}</p>
        </div>
      </div>
    );
  }

  return (
    <div className="max-w-3xl mx-auto">
      {/* 헤더 */}
      <div className="mb-5">
        <h1 className="text-xl font-extrabold text-gray-900 mb-1">
          {t('🤝 통합 서비스 의뢰 관리', '🤝 综合服务委托管理')}
        </h1>
        <p className="text-xs text-gray-500">
          {t('서비스 신청 내역과 공장매칭·시장조사 의뢰를 한 곳에서 관리하세요', '在一处管理服务申请记录和工厂匹配·市场调研委托')}
        </p>
      </div>

      {/* 요약 카드 */}
      <div className="grid grid-cols-2 gap-3 mb-5">
        <div className="bg-white border border-gray-100 rounded-2xl p-3 text-center shadow-sm">
          <div className="text-2xl font-extrabold text-green-600">{pendingSRCount}</div>
          <div className="text-xs text-gray-400 mt-0.5">{t('MD 답변 확인 필요', 'MD回复待确认')}</div>
        </div>
        <div className="bg-white border border-gray-100 rounded-2xl p-3 text-center shadow-sm">
          <div className="text-2xl font-extrabold text-purple-600">{pendingURCount}</div>
          <div className="text-xs text-gray-400 mt-0.5">{t('보고서 완료 확인 필요', '报告待确认')}</div>
        </div>
      </div>

      {/* 메인 탭 */}
      <div className="flex gap-2 mb-4 border-b border-gray-100">
        <button
          onClick={() => setMainTab('service-requests')}
          className={`pb-3 px-1 text-sm font-bold border-b-2 transition-all ${mainTab === 'service-requests' ? 'border-orange-500 text-orange-600' : 'border-transparent text-gray-400 hover:text-gray-600'}`}
        >
          {t('서비스 신청 내역', '服务申请记录')}
          {pendingSRCount > 0 && (
            <span className="ml-1.5 bg-orange-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full">
              {pendingSRCount}
            </span>
          )}
        </button>
        <button
          onClick={() => setMainTab('unified-requests')}
          className={`pb-3 px-1 text-sm font-bold border-b-2 transition-all ${mainTab === 'unified-requests' ? 'border-purple-600 text-purple-700' : 'border-transparent text-gray-400 hover:text-gray-600'}`}
        >
          {t('공장매칭·시장조사 의뢰', '工厂匹配·市场调研委托')}
          {pendingURCount > 0 && (
            <span className="ml-1.5 bg-purple-600 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full">
              {pendingURCount}
            </span>
          )}
        </button>
        <div className="flex-1" />
        {mainTab === 'service-requests' && (
          <Link
            href="/seller/service-requests/new"
            className="pb-3 text-xs font-semibold text-orange-500 hover:text-orange-600 flex items-center gap-1"
          >
            + {t('서비스 신청', '申请服务')}
          </Link>
        )}
        {mainTab === 'unified-requests' && (
          <Link
            href="/seller/unified-request/new"
            className="pb-3 text-xs font-semibold text-purple-600 hover:text-purple-700 flex items-center gap-1"
          >
            + {t('의뢰서 작성', '新建委托')}
          </Link>
        )}
      </div>

      {/* ─── 서비스 신청 내역 탭 ─── */}
      {mainTab === 'service-requests' && (
        <div>
          {/* 상태 필터 */}
          <div className="flex gap-2 mb-3 overflow-x-auto pb-1">
            {[
              { id: 'all',         ko: '전체',    zh: '全部',   count: serviceRequests.length },
              { id: 'pending',     ko: '접수 대기', zh: '待接收', count: serviceRequests.filter(r => r.status === 'pending').length },
              { id: 'in_progress', ko: '처리 중',   zh: '处理中', count: serviceRequests.filter(r => r.status === 'in_progress').length },
              { id: 'replied',     ko: 'MD 답변',   zh: 'MD回复', count: serviceRequests.filter(r => r.status === 'replied').length },
              { id: 'completed',   ko: '완료',      zh: '已完成', count: serviceRequests.filter(r => r.status === 'completed').length },
            ].map(tab => (
              <button
                key={tab.id}
                onClick={() => setSrFilter(tab.id)}
                className="flex items-center gap-1 shrink-0 text-xs font-semibold py-1.5 px-3 rounded-full transition-all"
                style={{
                  background: srFilter === tab.id ? brandColor : '#f3f4f6',
                  color: srFilter === tab.id ? '#fff' : '#6b7280',
                }}
              >
                {lang === 'zh' ? tab.zh : tab.ko}
                <span
                  className="text-[10px] font-bold px-1.5 py-0.5 rounded-full"
                  style={{
                    background: srFilter === tab.id ? 'rgba(255,255,255,0.3)' : '#e5e7eb',
                    color: srFilter === tab.id ? '#fff' : '#9ca3af',
                  }}
                >
                  {tab.count}
                </span>
              </button>
            ))}
          </div>

          {filteredSR.length === 0 ? (
            <div className="text-center py-12 bg-white border border-gray-100 rounded-2xl">
              <div className="text-4xl mb-3">📋</div>
              <div className="text-sm text-gray-400">{t('서비스 신청 내역이 없습니다', '暂无服务申请记录')}</div>
              <Link href="/seller/service-requests/new" className="mt-3 inline-block text-xs text-orange-500 hover:underline">
                {t('서비스 신청하기 →', '申请服务 →')}
              </Link>
            </div>
          ) : (
            <div className="flex flex-col gap-2">
              {filteredSR.map(req => {
                const stype = SERVICE_TYPE[req.service_type] || { ko: req.service_type, zh: req.service_type, icon: '📋', color: '#6b7280' };
                const sstatus = SR_STATUS[req.status] || { ko: req.status, zh: req.status, color: '#6b7280' };
                const hasNewReply = req.status === 'replied';
                return (
                  <Link key={req.id} href={`/seller/service-requests/${req.id}`} className="no-underline">
                    <div className={`bg-white border rounded-2xl py-3.5 px-4 shadow-sm hover:shadow-md transition-shadow ${hasNewReply ? 'border-green-300' : 'border-gray-100'}`}>
                      <div className="flex items-center justify-between mb-1.5">
                        <div className="flex items-center gap-2">
                          <span className="text-base">{stype.icon}</span>
                          <span className="text-xs font-bold" style={{ color: stype.color }}>
                            {lang === 'zh' ? stype.zh : stype.ko}
                          </span>
                          {req.is_urgent && (
                            <span className="text-[10px] font-bold bg-red-100 text-red-600 px-1.5 py-0.5 rounded-full">
                              {t('긴급', '紧急')}
                            </span>
                          )}
                        </div>
                        <span
                          className="text-[11px] font-semibold px-2 py-0.5 rounded-full"
                          style={{ background: `${sstatus.color}20`, color: sstatus.color }}
                        >
                          {lang === 'zh' ? sstatus.zh : sstatus.ko}
                        </span>
                      </div>
                      <div className="flex items-center justify-between">
                        <div>
                          <div className="text-sm font-semibold text-gray-800">
                            {lang === 'zh' ? (req.product_name_zh || req.product_name) : req.product_name}
                          </div>
                          <div className="text-xs text-gray-400 mt-0.5">
                            {req.request_no} · {new Date(req.created_at).toLocaleDateString('ko-KR')}
                          </div>
                        </div>
                        {hasNewReply && (
                          <span className="text-xs font-bold bg-green-500 text-white px-2 py-1 rounded-full">
                            {t('새 답변', '新回复')}
                          </span>
                        )}
                      </div>
                    </div>
                  </Link>
                );
              })}
            </div>
          )}
        </div>
      )}

      {/* ─── 통합의뢰(공장매칭·시장조사) 탭 ─── */}
      {mainTab === 'unified-requests' && (
        <div>
          {unifiedRequests.length === 0 ? (
            <div className="text-center py-12 bg-white border border-gray-100 rounded-2xl">
              <div className="text-4xl mb-3">🏭</div>
              <div className="text-sm text-gray-400">{t('의뢰 내역이 없습니다', '暂无委托记录')}</div>
              <p className="text-xs text-gray-300 mt-1">
                {t('새 의뢰서를 작성하면 전담 MD가 최적의 공장을 찾아드립니다', '提交新委托书后，专属MD将为您找到最优工厂')}
              </p>
              <Link href="/seller/unified-request/new" className="mt-3 inline-block text-xs text-purple-600 hover:underline">
                {t('의뢰서 작성하기 →', '新建委托书 →')}
              </Link>
            </div>
          ) : (
            <div className="flex flex-col gap-2">
              {unifiedRequests.map((req: any) => {
                const urstatus = UR_STATUS[req.status] || { ko: req.status, zh: req.status, color: '#6b7280' };
                const rtype = SERVICE_TYPE[req.request_type] || { ko: req.request_type, zh: req.request_type, icon: '📋', color: '#6b7280' };
                return (
                  <Link key={req.id} href={`/seller/unified-request/${req.id}`} className="no-underline">
                    <div className="bg-white border border-gray-100 rounded-2xl py-3.5 px-4 shadow-sm hover:shadow-md transition-shadow">
                      <div className="flex items-center justify-between mb-1.5">
                        <div className="flex items-center gap-2">
                          <span className="text-base">{rtype.icon}</span>
                          <span className="text-xs font-bold" style={{ color: rtype.color }}>
                            {lang === 'zh' ? rtype.zh : rtype.ko}
                          </span>
                        </div>
                        <span
                          className="text-[11px] font-semibold px-2 py-0.5 rounded-full"
                          style={{ background: `${urstatus.color}20`, color: urstatus.color }}
                        >
                          {lang === 'zh' ? urstatus.zh : urstatus.ko}
                        </span>
                      </div>
                      <div className="flex items-center justify-between">
                        <div>
                          <div className="text-sm font-semibold text-gray-800">
                            {lang === 'zh' ? (req.product_name_zh || req.product_name || req.title) : (req.product_name || req.title || t('의뢰서', '委托书'))}
                          </div>
                          <div className="text-xs text-gray-400 mt-0.5">
                            {new Date(req.created_at).toLocaleDateString('ko-KR')}
                          </div>
                        </div>
                        {req.status === 'report_ready' && (
                          <span className="text-xs font-bold bg-purple-500 text-white px-2 py-1 rounded-full">
                            {t('보고서 완료', '报告完成')}
                          </span>
                        )}
                      </div>
                    </div>
                  </Link>
                );
              })}
            </div>
          )}
        </div>
      )}
    </div>
  );
}
