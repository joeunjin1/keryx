'use client';

import { useState } from 'react';
import Link from 'next/link';
import { PublicHeader } from '@/components/layout/PublicHeader';
import { PublicFooter } from '@/components/layout/PublicFooter';

const FAQ_CATEGORIES = [
  {
    id: 'membership',
    icon: '👑',
    label: '멤버십',
    labelZh: '会员',
    items: [
      {
        q: '멤버십은 어떻게 가입하나요?',
        qZh: '如何加入会员？',
        a: '회원가입 후 /membership 페이지에서 원하는 플랜을 선택하고 신청하시면 됩니다. 담당 MD가 24시간 이내에 결제 안내를 드립니다.',
        aZh: '注册后在/membership页面选择所需方案并提交申请，专属MD将在24小时内为您提供付款指导。',
      },
      {
        q: 'BASIC과 PRO의 차이는 무엇인가요?',
        qZh: 'BASIC和PRO有什么区别？',
        a: 'BASIC(¥300/월)은 공장 매칭 월 2회, 시장조사 월 10건을 제공합니다. PRO(¥500/월)는 공장 매칭 월 4회, 시장조사 무제한, 전담 MD 배정, 우선 처리 서비스를 제공합니다.',
        aZh: 'BASIC(¥300/月)提供每月2次工厂匹配和10次市场调研。PRO(¥500/月)提供每月4次工厂匹配、无限次市场调研、专属MD分配和优先处理服务。',
      },
      {
        q: '결제 방법은 무엇인가요?',
        qZh: '支持哪些付款方式？',
        a: '위챗페이(WeChat Pay), 알리페이(Alipay), 국제 카드(Visa/Mastercard)를 지원합니다. 결제 신청 후 담당자가 상세 안내를 드립니다.',
        aZh: '支持微信支付、支付宝、国际信用卡(Visa/Mastercard)。提交申请后，工作人员将为您提供详细指导。',
      },
      {
        q: '환불 정책은 어떻게 되나요?',
        qZh: '退款政策是什么？',
        a: '결제 후 7일 이내, 서비스 미이용 시 전액 환불이 가능합니다. 이용 후에는 잔여 기간에 대한 부분 환불이 가능합니다.',
        aZh: '付款后7天内未使用服务可全额退款，使用后可按剩余天数部分退款。',
      },
    ],
  },
  {
    id: 'sourcing',
    icon: '🏭',
    label: '소싱 & 공장 매칭',
    labelZh: '采购与工厂匹配',
    items: [
      {
        q: '공장 매칭 신청은 어떻게 하나요?',
        qZh: '如何申请工厂匹配？',
        a: '바이어 대시보드 → 매칭 신청 버튼을 클릭하여 제품 정보(카테고리, 수량, 가격대, 참고 이미지)를 입력하시면 됩니다. KERYX MD팀이 48시간 이내에 최적의 공장 리스트를 제공합니다.',
        aZh: '在买家仪表板点击"匹配申请"按钮，填写产品信息（类别、数量、价格范围、参考图片）即可。KERYX MD团队将在48小时内提供最优工厂列表。',
      },
      {
        q: '최소 주문 수량(MOQ)은 얼마인가요?',
        qZh: '最小起订量(MOQ)是多少？',
        a: '공장마다 다르지만 일반적으로 100~500개입니다. 소량 주문이 필요하신 경우 MD에게 문의하시면 소량 가능 공장을 찾아드립니다.',
        aZh: '每个工厂不同，一般为100~500件。如需小批量订单，请联系MD，我们将为您寻找支持小批量的工厂。',
      },
      {
        q: '샘플 발주는 어떻게 진행되나요?',
        qZh: '样品订单如何进行？',
        a: '공장 매칭 완료 후 MD를 통해 샘플 발주를 진행할 수 있습니다. 샘플 비용은 공장마다 다르며, 본 발주 시 샘플 비용을 공제해주는 공장도 있습니다.',
        aZh: '工厂匹配完成后，可通过MD进行样品订单。样品费用因工厂而异，部分工厂在正式下单时会抵扣样品费用。',
      },
      {
        q: '공장의 품질은 어떻게 보장되나요?',
        qZh: '如何保证工厂质量？',
        a: 'KERYX에 등록된 모든 공장은 사전 검증 과정을 거칩니다. 출고 전 검수 서비스를 통해 품질을 확인하고, 검수 보고서를 제공합니다.',
        aZh: 'KERYX注册的所有工厂都经过事先验证。通过出货前验货服务确认质量，并提供验货报告。',
      },
    ],
  },
  {
    id: 'order',
    icon: '📦',
    label: '주문 & 배송',
    labelZh: '订单与物流',
    items: [
      {
        q: '주문 후 배송까지 얼마나 걸리나요?',
        qZh: '下单后多久能收到货？',
        a: '제품 종류와 수량에 따라 다르지만, 일반적으로 생산 15~30일 + 해상 운송 7~15일입니다. 항공 운송 이용 시 3~7일로 단축됩니다.',
        aZh: '根据产品种类和数量而异，一般为生产15~30天+海运7~15天。使用空运可缩短至3~7天。',
      },
      {
        q: '통관 및 관세는 어떻게 처리되나요?',
        qZh: '清关和关税如何处理？',
        a: 'KERYX는 통관 서비스를 지원합니다. 한국 수입 시 발생하는 관세 및 부가세는 수입자(바이어) 부담입니다. 관세율은 품목마다 다르며 MD가 안내해드립니다.',
        aZh: 'KERYX提供清关服务。进口韩国时产生的关税和增值税由进口商（买家(客户)）承担。关税率因品目而异，MD将为您提供指导。',
      },
      {
        q: '주문 취소 및 변경은 가능한가요?',
        qZh: '可以取消或修改订单吗？',
        a: '생산 시작 전에는 주문 취소 및 변경이 가능합니다. 생산 시작 후에는 취소가 어려울 수 있으며, 이 경우 담당 MD에게 즉시 연락해주세요.',
        aZh: '生产开始前可以取消或修改订单。生产开始后可能难以取消，请立即联系您的专属MD。',
      },
    ],
  },
  {
    id: 'account',
    icon: '👤',
    label: '계정 & 보안',
    labelZh: '账户与安全',
    items: [
      {
        q: '비밀번호를 잊어버렸어요.',
        qZh: '忘记密码了。',
        a: '로그인 페이지에서 "비밀번호 찾기"를 클릭하시면 이메일로 재설정 링크를 보내드립니다.',
        aZh: '在登录页面点击"找回密码"，我们将向您的邮箱发送重置链接。',
      },
      {
        q: '회사 정보를 변경하고 싶어요.',
        qZh: '想修改公司信息。',
        a: '바이어 대시보드 → 프로필 설정에서 회사명, 담당자명, 연락처 등을 수정할 수 있습니다.',
        aZh: '在买家仪表板→个人资料设置中可以修改公司名称、联系人姓名、联系方式等。',
      },
      {
        q: '카카오/구글로 가입했는데 이메일 로그인도 가능한가요?',
        qZh: '用Kakao/Google注册后，也可以用邮箱登录吗？',
        a: '소셜 로그인으로 가입하신 경우 비밀번호 설정 후 이메일 로그인도 가능합니다. 고객센터로 문의해주세요.',
        aZh: '通过社交登录注册后，设置密码即可使用邮箱登录。请联系客服。',
      },
    ],
  },
];

export default function SupportPage() {
  const [lang, setLang] = useState<'ko' | 'zh' | 'en'>('ko');
  const [activeCategory, setActiveCategory] = useState('membership');
  const [openFaq, setOpenFaq] = useState<number | null>(null);
  const [contactForm, setContactForm] = useState({ name: '', email: '', message: '' });
  const [submitted, setSubmitted] = useState(false);

  const t = (ko: string, zh: string) => (lang === 'ko' ? ko : zh);
  const activeItems = FAQ_CATEGORIES.find((c) => c.id === activeCategory)?.items ?? [];

  function handleContact(e: React.FormEvent) {
    e.preventDefault();
    setSubmitted(true);
  }

  return (
    <div style={{ minHeight: '100vh', background: '#f8f9fa', fontFamily: "'Pretendard', -apple-system, sans-serif" }}>
      <PublicHeader lang={lang} onLangChange={setLang} theme="light" />


      <div style={{
        background: 'linear-gradient(135deg, #1a1a2e 0%, #6366f1 100%)',
        padding: 'clamp(40px, 6vw, 72px) 24px',
        textAlign: 'center', color: '#fff',
      }}>
        <div style={{ fontSize: 40, marginBottom: 16 }}>🤝</div>
        <h1 style={{ fontSize: 'clamp(24px, 4vw, 40px)', fontWeight: 800, marginBottom: 12, letterSpacing: '-0.5px' }}>
          {t('무엇을 도와드릴까요?', '我们能为您提供什么帮助？')}
        </h1>
        <p style={{ fontSize: 15, opacity: 0.85, maxWidth: 480, margin: '0 auto 28px', lineHeight: 1.7 }}>
          {t(
            'KERYX 전담팀이 소싱부터 납품까지 모든 과정을 친절하게 안내해드립니다.',
            'KERYX专属团队将从采购到交货全程为您提供贴心指导。'
          )}
        </p>


        <div style={{ display: 'flex', justifyContent: 'center', gap: 12, flexWrap: 'wrap' }}>
          {[
            { icon: '💬', label: 'KakaoTalk', value: '@keryx_support', bg: '#FEE500', tc: '#000' },
            { icon: '📧', label: t('이메일', '邮件'), value: 'support@keryx.kr', bg: 'rgba(255,255,255,0.15)', tc: '#fff' },
            { icon: '💬', label: 'WeChat', value: 'keryx_cn', bg: '#07c160', tc: '#fff' },
          ].map((c) => (
            <div key={c.label} style={{
              background: c.bg, borderRadius: 10, padding: '10px 16px',
              display: 'flex', alignItems: 'center', gap: 8,
            }}>
              <span className="text-lg">{c.icon}</span>
              <div>
                <div style={{ fontSize: 10, fontWeight: 700, color: c.tc, opacity: 0.75 }}>{c.label}</div>
                <div style={{ fontSize: 12, fontWeight: 700, color: c.tc }}>{c.value}</div>
              </div>
            </div>
          ))}
        </div>

        <p style={{ fontSize: 12, opacity: 0.6, marginTop: 16 }}>
          {t('평일 09:00 ~ 18:00 (KST) · 주말 및 공휴일 휴무', '工作日 09:00~18:00 (韩国时间) · 周末及节假日休息')}
        </p>
      </div>


      <div style={{ maxWidth: 1000, margin: '0 auto', padding: '40px 24px' }}>
        <div style={{ display: 'grid', gridTemplateColumns: 'minmax(0, 1fr) minmax(0, 2fr)', gap: 32 }}>


          <div>

            <div style={{ background: '#fff', borderRadius: 16, padding: 20, marginBottom: 20, boxShadow: '0 1px 4px rgba(0,0,0,0.06)' }}>
              <h3 style={{ fontSize: 14, fontWeight: 700, color: '#374151', marginBottom: 12 }}>
                {t('도움말 카테고리', '帮助类别')}
              </h3>
              <div className="flex flex-col gap-1">
                {FAQ_CATEGORIES.map((cat) => (
                  <button
                    key={cat.id}
                    onClick={() => { setActiveCategory(cat.id); setOpenFaq(null); }}
                    style={{
                      padding: '10px 14px', borderRadius: 10, border: 'none', textAlign: 'left',
                      background: activeCategory === cat.id ? '#ede9fe' : 'transparent',
                      color: activeCategory === cat.id ? '#6366f1' : '#374151',
                      fontSize: 13, fontWeight: activeCategory === cat.id ? 700 : 500,
                      cursor: 'pointer', display: 'flex', alignItems: 'center', gap: 8,
                    }}
                  >
                    <span>{cat.icon}</span>
                    <span>{t(cat.label, cat.labelZh)}</span>
                  </button>
                ))}
              </div>
            </div>


            <div style={{ background: '#fff', borderRadius: 16, padding: 20, boxShadow: '0 1px 4px rgba(0,0,0,0.06)' }}>
              <h3 style={{ fontSize: 14, fontWeight: 700, color: '#374151', marginBottom: 4 }}>
                {t('1:1 문의하기', '1对1咨询')}
              </h3>
              <p style={{ fontSize: 12, color: '#9ca3af', marginBottom: 16 }}>
                {t('평균 응답시간: 24시간 이내', '平均响应时间: 24小时内')}
              </p>

              {submitted ? (
                <div style={{ textAlign: 'center', padding: '20px 0' }}>
                  <div style={{ fontSize: 40, marginBottom: 12 }}>✅</div>
                  <p style={{ fontSize: 14, fontWeight: 700, color: '#374151', marginBottom: 4 }}>
                    {t('문의가 접수되었습니다!', '咨询已提交！')}
                  </p>
                  <p className="text-[12px] text-neutral-400">
                    {t('24시간 이내에 답변 드리겠습니다.', '我们将在24小时内回复您。')}
                  </p>
                  <button
                    onClick={() => { setSubmitted(false); setContactForm({ name: '', email: '', message: '' }); }}
                    style={{ marginTop: 12, padding: '8px 16px', background: '#6366f1', color: '#fff', border: 'none', borderRadius: 8, fontSize: 12, fontWeight: 600, cursor: 'pointer' }}
                  >
                    {t('새 문의 작성', '新建咨询')}
                  </button>
                </div>
              ) : (
                <form onSubmit={handleContact} className="flex flex-col gap-3">
                  <div>
                    <label style={{ fontSize: 12, fontWeight: 600, color: '#374151', display: 'block', marginBottom: 4 }}>
                      {t('이름 / 회사명', '姓名 / 公司名')}
                    </label>
                    <input
                      required value={contactForm.name}
                      onChange={(e) => setContactForm({ ...contactForm, name: e.target.value })}
                      placeholder={t('예: 가자트레이드', '例: 某某贸易')}
                      style={{ width: '100%', padding: '9px 12px', border: '1px solid #e5e7eb', borderRadius: 8, fontSize: 13, outline: 'none', boxSizing: 'border-box' }}
                    />
                  </div>
                  <div>
                    <label style={{ fontSize: 12, fontWeight: 600, color: '#374151', display: 'block', marginBottom: 4 }}>
                      {t('이메일', '邮箱')}
                    </label>
                    <input
                      type="email" required value={contactForm.email}
                      onChange={(e) => setContactForm({ ...contactForm, email: e.target.value })}
                      placeholder="example@company.com"
                      style={{ width: '100%', padding: '9px 12px', border: '1px solid #e5e7eb', borderRadius: 8, fontSize: 13, outline: 'none', boxSizing: 'border-box' }}
                    />
                  </div>
                  <div>
                    <label style={{ fontSize: 12, fontWeight: 600, color: '#374151', display: 'block', marginBottom: 4 }}>
                      {t('문의 내용', '咨询内容')}
                    </label>
                    <textarea
                      required value={contactForm.message}
                      onChange={(e) => setContactForm({ ...contactForm, message: e.target.value })}
                      placeholder={t('궁금하신 내용을 자세히 적어주세요.', '请详细描述您的问题。')}
                      rows={4}
                      style={{ width: '100%', padding: '9px 12px', border: '1px solid #e5e7eb', borderRadius: 8, fontSize: 13, outline: 'none', resize: 'vertical', boxSizing: 'border-box' }}
                    />
                  </div>
                  <button
                    type="submit"
                    className="active:scale-95 transition-all" style={{ padding: '11px', background: 'linear-gradient(135deg, #6366f1, #8b5cf6)', color: '#fff', border: 'none', borderRadius: 8, fontSize: 13, fontWeight: 700, cursor: 'pointer' }}
                  >
                    {t('문의 보내기 →', '发送咨询 →')}
                  </button>
                </form>
              )}
            </div>
          </div>


          <div>
            <div style={{ background: '#fff', borderRadius: 16, padding: 24, boxShadow: '0 1px 4px rgba(0,0,0,0.06)' }}>
              <h2 style={{ fontSize: 18, fontWeight: 800, color: '#1a1a2e', marginBottom: 20 }}>
                {t('자주 묻는 질문', '常见问题')} — {t(
                  FAQ_CATEGORIES.find((c) => c.id === activeCategory)?.label ?? '',
                  FAQ_CATEGORIES.find((c) => c.id === activeCategory)?.labelZh ?? ''
                )}
              </h2>
              <div className="flex flex-col gap-2">
                {activeItems.map((item, i) => (
                  <div key={i} style={{ border: '1px solid #f3f4f6', borderRadius: 12, overflow: 'hidden' }}>
                    <button
                      onClick={() => setOpenFaq(openFaq === i ? null : i)}
                      style={{
                        width: '100%', padding: '16px 18px', background: openFaq === i ? '#f5f3ff' : '#fff',
                        border: 'none', color: '#1a1a2e', fontSize: 14, fontWeight: 600, textAlign: 'left',
                        cursor: 'pointer', display: 'flex', justifyContent: 'space-between', alignItems: 'center',
                        transition: 'background 0.15s',
                      }}
                    >
                      <span className="pr-3">
                        <span style={{ color: '#6366f1', marginRight: 8 }}>Q.</span>
                        {t(item.q, item.qZh)}
                      </span>
                      <span style={{
                        color: '#9ca3af', fontSize: 16, flexShrink: 0,
                        transform: openFaq === i ? 'rotate(180deg)' : 'none',
                        transition: 'transform 0.2s',
                      }}>▾</span>
                    </button>
                    {openFaq === i && (
                      <div style={{
                        padding: '14px 18px 18px', fontSize: 13, color: '#4b5563',
                        lineHeight: 1.8, background: '#fafafa',
                        borderTop: '1px solid #f3f4f6',
                      }}>
                        <span style={{ color: '#6366f1', fontWeight: 700, marginRight: 8 }}>A.</span>
                        {t(item.a, item.aZh)}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </div>


            <div style={{
              marginTop: 20, padding: '20px 24px',
              background: 'linear-gradient(135deg, #ede9fe, #ddd6fe)',
              borderRadius: 16, border: '1px solid #c4b5fd',
            }}>
              <div style={{ display: 'flex', alignItems: 'flex-start', gap: 14 }}>
                <span style={{ fontSize: 28, flexShrink: 0 }}>💡</span>
                <div>
                  <h4 style={{ fontSize: 14, fontWeight: 700, color: '#5b21b6', marginBottom: 6 }}>
                    {t('처음 소싱을 시작하시나요?', '第一次开始采购吗？')}
                  </h4>
                  <p style={{ fontSize: 13, color: '#6d28d9', lineHeight: 1.7, marginBottom: 12 }}>
                    {t(
                      'KERYX 멤버십에 가입하시면 전담 MD가 소싱 전 과정을 1:1로 안내해드립니다. 첫 달은 무료로 체험해보세요!',
                      '加入KERYX会员，专属MD将1对1全程指导您的采购过程。首月免费体验！'
                    )}
                  </p>
                  <Link
                    href="/membership"
                    style={{
                      display: 'inline-block', padding: '9px 18px',
                      background: '#6366f1', color: '#fff', borderRadius: 8,
                      fontSize: 13, fontWeight: 700, textDecoration: 'none',
                    }}
                  >
                    {t('멤버십 알아보기 →', '了解会员服务 →')}
                  </Link>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>


      <PublicFooter lang={lang} theme="dark" />
    </div>
  );
}
